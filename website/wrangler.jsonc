{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heartpro-website",
  "compatibility_date": "2026-09-20",
  "routes": [
    {
      "pattern": "heartpro.alkinum.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./build",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/support*"
    ]
  },
  "main": "worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  }
}
